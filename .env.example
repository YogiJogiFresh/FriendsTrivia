HOST=0.0.0.0
PORT=3000
JOIN_PORT=
PUBLIC_URL=
DATABASE_PATH=./data/friends-trivia.db
CONTENT_ROOT=./content
ROOM_CODE_LENGTH=4
GIPHY_API_KEY=
TENOR_API_KEY=

# Offline remains the default. Do not point cloud mode at a local SQLite/media folder.
FRIENDS_TRIVIA_MODE=local
# Cloud-only settings: Node.js 22+, managed identity, and no application sign-in.
COSMOS_ENDPOINT=
COSMOS_DATABASE=friends-trivia
COSMOS_GAMES_CONTAINER=games
COSMOS_LIBRARY_CONTAINER=library
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=songs

# Live tests use a separate database, never the production database above.
COSMOS_TEST_DATABASE=friends-trivia-tests
