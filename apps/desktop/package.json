{
  "name": "@friends-trivia/desktop",
  "version": "0.2.2",
  "private": true,
  "description": "FriendsTrivia desktop host application",
  "author": "YogiJogiFresh",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main.cjs --external:electron --external:electron-updater --external:better-sqlite3 --external:@fastify/helmet --external:@fastify/multipart --external:@fastify/rate-limit --external:@fastify/static --external:dotenv --external:fastify --external:socket.io",
    "rebuild:native": "cd node_modules/better-sqlite3 && prebuild-install --runtime electron --target 33.4.11 --arch x64",
    "dev": "npm run build:main && electron .",
    "build": "npm run build:main && npm run rebuild:native && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "11.10.0",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.3",
    "fastify": "^5.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.friendstrivia.app",
    "productName": "FriendsTrivia",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FriendsTrivia",
      "uninstallDisplayName": "FriendsTrivia"
    },
    "publish": {
      "provider": "github",
      "owner": "YogiJogiFresh",
      "repo": "FriendsTrivia"
    }
  }
}
